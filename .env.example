# Server Configuration
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=ayushbasket_db

# JWT & Security Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
OTP_SECRET=your_otp_hmac_secret_key_for_secure_hashing

# ==============================================================================
# Twilio SMS & Verification Gateway Configuration
# ==============================================================================
# Set SMS_ENABLED=true for live delivery; false for development/test mock mode
SMS_ENABLED=false

# Account Authentication (Option A: Account SID + Auth Token)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Account Authentication (Option B: Account SID + API Key + API Secret)
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_SECRET=your_twilio_api_secret_here

# Outbound Sender Configuration for Order Notifications (Provide at least one):
# 1. Twilio Messaging Service SID (Recommended for international pools & alpha sender routing):
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# 2. Or a direct Twilio purchased phone number (in E.164 format, e.g. +1XXXXXXXXXX):
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Optional: Twilio Verify Service SID (If using Twilio Verify for OTPs instead of local SMS):
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# Payment Gateway (Razorpay)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================================================
# Cloudinary (Image Uploads)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# SMTP Mailer (Optional)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_app_password
