PORT=5000

# ─── Database (MySQL) ───────────────────────────────────────
DB_HOST=193.203.184.99
DB_PORT=3306
DB_USER=u237482260_ayushuser
DB_PASSWORD=Ayush@2026DB@#
DB_NAME=u237482260_ayushbasket

# ─── JWT Authentication ──────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here

# ─── Email / SMTP (optional) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# ─── SMS Gateway (SpearUC) ──────────────────────────────────
SMS_ENABLED=true
SPEAR_UC_BASE_URL=https://login4.spearuc.com/MOBILE_APPS_API/sms_api.php
SPEAR_UC_AUTH_KEY=your_auth_key
SPEAR_UC_SENDER_ID=your_sender_id
SPEAR_UC_TID_REGISTRATION=your_template_id
DLT_TEMPLATE_ID_ORDER_PLACED=your_dlt_template_id_1
DLT_TEMPLATE_ID_ORDER_ACCEPTED=your_dlt_template_id_2
DLT_TEMPLATE_ID_ORDER_COMPLETED=your_dlt_template_id_3

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
PAYMENT_MODE=mock
